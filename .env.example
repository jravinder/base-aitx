# Copy to .env, fill in, then load it: set -a; source .env; set +a
# On Vercel, set the same names under Project Settings > Environment Variables.

# Required for photo reading (api/read-photo.js, brain/ask.py /photo/read) and the Gemini voice (api/tts.js)
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare Turnstile secret key: bot check on /api/read-photo and /api/tts (api/_turnstile.js).
# Unset = check skipped. Set it together with the matching SITEKEY in web/turnstile.js.
# Cloudflare test secrets: 1x0000000000000000000000000000000AA always passes, 2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET=

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Local AI (brain/ask.py). Needs Ollama running with the model pulled: ollama pull gemma4:e4b
OLLAMA=http://localhost:11434
ASK_MODEL=gemma4:e4b
# JETSON_OLLAMA=http://jetson:11434   # optional second local box for the benchmark

# Optional switches
# BRAIN_KB=0      # answer without the Base Brain knowledge base
# LEARN_LOG=0     # do not log member questions for the learning loop
# ASK_TODAY=2026-09-27   # pin "today" for reproducible answers
# JEV_API_KEY=    # optional permit-judge backend (store/judge.py); the default judge is local Ollama
